# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Origins & URLs (e.g. https://chocolate-clicks.me in production, or http://localhost:5173 in local dev)
CLIENT_URL=https://chocolate-clicks.me
FRONTEND_URL=https://chocolate-clicks.me
BACKEND_PUBLIC_URL=https://chocolate-clicks-backend.vercel.app

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
ADMIN_SETUP_SECRET=your_admin_setup_secret_here
ADMIN_SIGNUP_SECRET=your_admin_signup_secret_here

# Payment Gateway (PayHere)
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (SMTP Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Chocolate Clicks" <no-reply@chocolateclicks.com>

# Google OAuth
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
